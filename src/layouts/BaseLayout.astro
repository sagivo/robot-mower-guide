---
import "@fontsource-variable/inter/wght.css";
import "@fontsource-variable/sora/wght.css";
import interLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import soraLatin from "@fontsource-variable/sora/files/sora-latin-wght-normal.woff2?url";
import "../styles/global.css";
import { SITE_NAME, SITE_URL, SITE_DESCRIPTION, OG_DEFAULT, NAV } from "../lib/site";
import { organizationLd } from "../lib/schema";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  article?: { pubDate: string; updatedDate?: string };
}

const {
  title,
  description = SITE_DESCRIPTION,
  canonical,
  ogImage = OG_DEFAULT,
  jsonLd,
  noindex = false,
  article,
} = Astro.props;

const pageUrl = canonical ?? new URL(Astro.url.pathname, SITE_URL).toString();
const fullTitle = title === SITE_NAME || title.includes(SITE_NAME) ? title : `${title} | ${SITE_NAME}`;
const ld = [organizationLd(), ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
const path = Astro.url.pathname;
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}
    <meta name="theme-color" content="#14331b" />

    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={soraLatin} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {article && <meta property="article:published_time" content={article.pubDate} />}
    {article?.updatedDate && <meta property="article:modified_time" content={article.updatedDate} />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} guides`} href="/rss.xml" />

    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap wide header-inner">
        <a class="brand" href="/" aria-label={`${SITE_NAME} home`}>
          <span class="brand-mark" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 32 32"><rect x="4" y="14" width="18" height="9" rx="4.5" fill="#fff"/><circle cx="10" cy="25" r="3.4" fill="#fff"/><circle cx="20" cy="25" r="3.4" fill="#fff"/><path d="M22 12l4-4" stroke="#fff" stroke-width="2.4" stroke-linecap="round"/><circle cx="27" cy="6.5" r="1.8" fill="#b8e62e"/></svg>
          </span>
          <span>{SITE_NAME}</span>
        </a>
        <button class="menu-btn" type="button" aria-label="Menu" aria-expanded="false" aria-controls="primary-nav">
          <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
        </button>
        <nav id="primary-nav" aria-label="Primary">
          {NAV.map((n) => (
            <a href={n.href} aria-current={isActive(n.href) ? "page" : undefined}>{n.label}</a>
          ))}
          <a class="nav-search" href="/search/" aria-label="Search">
            <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2.4" fill="none"/><path d="m16.5 16.5 4 4" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
            <span class="nav-search-label">Search</span>
          </a>
          <a class="nav-cta" href="/tools/size-matcher/">Find my mower</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap wide">
        <div class="footer-grid">
          <div>
            <div class="footer-brand">
              <span class="brand-mark" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 32 32"><rect x="4" y="14" width="18" height="9" rx="4.5" fill="#fff"/><circle cx="10" cy="25" r="3.4" fill="#fff"/><circle cx="20" cy="25" r="3.4" fill="#fff"/><path d="M22 12l4-4" stroke="#fff" stroke-width="2.4" stroke-linecap="round"/><circle cx="27" cy="6.5" r="1.8" fill="#b8e62e"/></svg>
              </span>
              {SITE_NAME}
            </div>
            <p class="footer-blurb">Independent guides to wire-free robot lawn mowers: comparisons, sizing tools, and real cost math. We cross-check every spec against several sources.</p>
            <p class="footer-blurb"><a href="/how-we-research/">How we research &amp; score →</a></p>
          </div>
          <div>
            <h2 class="footer-h">Best of 2026</h2>
            <ul>
              <li><a href="/posts/best-robot-lawn-mowers-2026/">Best robot mowers overall</a></li>
              <li><a href="/posts/best-robot-mower-for-hills/">Best for hills &amp; slopes</a></li>
              <li><a href="/posts/best-robot-mower-for-large-lawns/">Best for large lawns</a></li>
              <li><a href="/posts/best-robot-mower-for-small-yards/">Best for small yards</a></li>
              <li><a href="/posts/best-budget-robot-lawn-mower/">Best budget picks</a></li>
            </ul>
          </div>
          <div>
            <h2 class="footer-h">Free tools</h2>
            <ul>
              <li><a href="/tools/size-matcher/">Mower size matcher</a></li>
              <li><a href="/tools/cost-calculator/">Robot vs. lawn service</a></li>
              <li><a href="/tools/slope-checker/">Slope checker</a></li>
              <li><a href="/mowers/">Compare all mowers</a></li>
            </ul>
          </div>
          <div>
            <h2 class="footer-h">{SITE_NAME}</h2>
            <ul>
              <li><a href="/guides/">All guides</a></li>
              <li><a href="/about/">About</a></li>
              <li><a href="/how-we-research/">How we research</a></li>
              <li><a href="/affiliate-disclosure/">Affiliate disclosure</a></li>
              <li><a href="/contact/">Contact</a></li>
              <li><a href="/privacy/">Privacy</a></li>
            </ul>
          </div>
        </div>
        <p class="disclosure">
          As an Amazon Associate {SITE_NAME} earns from qualifying purchases (<a href="/affiliate-disclosure/">disclosure</a>).
          Product prices and availability are accurate as of the date/time indicated
          and are subject to change.
        </p>
        <p class="copy">© {year} {SITE_NAME}. All rights reserved.</p>
      </div>
    </footer>
    <div class="viz-tip" id="viz-tip" role="tooltip" hidden><strong></strong><span></span></div>
    <script>
      // Shared tooltip for chart marks: any element with data-tip-value / data-tip-label.
      const tip = document.getElementById("viz-tip")!;
      const show = (el: HTMLElement) => {
        tip.querySelector("strong")!.textContent = el.dataset.tipValue ?? "";
        tip.querySelector("span")!.textContent = el.dataset.tipLabel ?? "";
        tip.hidden = false;
        const r = el.getBoundingClientRect();
        const t = tip.getBoundingClientRect();
        const left = Math.min(Math.max(8, r.left + r.width / 2 - t.width / 2), window.innerWidth - t.width - 8);
        const top = r.top - t.height - 8 < 8 ? r.bottom + 8 : r.top - t.height - 8;
        tip.style.transform = `translate(${left}px, ${top}px)`;
      };
      const target = (e: Event) => (e.target as HTMLElement).closest?.<HTMLElement>("[data-tip-value]");
      document.addEventListener("pointerover", (e) => { const el = target(e); if (el) show(el); });
      document.addEventListener("focusin", (e) => { const el = target(e); if (el) show(el); });
      document.addEventListener("pointerout", (e) => { if (target(e)) tip.hidden = true; });
      document.addEventListener("focusout", (e) => { if (target(e)) tip.hidden = true; });
      window.addEventListener("scroll", () => (tip.hidden = true), { passive: true });

      const btn = document.querySelector<HTMLButtonElement>(".menu-btn");
      const nav = document.getElementById("primary-nav");
      btn?.addEventListener("click", () => {
        const open = nav?.classList.toggle("open") ?? false;
        btn.setAttribute("aria-expanded", String(open));
      });
    </script>
  </body>
</html>
