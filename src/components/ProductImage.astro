---
// Product photo if one exists at src/assets/mowers/<model-id>.{jpg,jpeg,png,webp},
// otherwise a generated illustration. Only add photos you are licensed to use
// (Amazon PA-API / SiteStripe images, or manufacturer press-kit permission).
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { MowerModel } from "../data/models";
import MowerArt from "./MowerArt.astro";

interface Props {
  model: MowerModel;
  size?: number;
  eager?: boolean;
}
const { model, size = 96, eager = false } = Astro.props;

const photos = import.meta.glob<{ default: ImageMetadata }>("../assets/mowers/*.{jpg,jpeg,png,webp}", { eager: true });
const entry = Object.entries(photos).find(([path]) => path.split("/").pop()!.replace(/\.\w+$/, "") === model.id);
const photo = entry?.[1].default;
---

{photo ? (
  <Image
    class="product-photo"
    src={photo}
    alt={model.name}
    width={size}
    densities={[1, 2]}
    loading={eager ? "eager" : "lazy"}
    fetchpriority={eager ? "high" : "auto"}
  />
) : (
  <MowerArt model={model} size={size} />
)}
