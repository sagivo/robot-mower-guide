---
import type { MowerModel } from "../data/models";
import { formatMoney } from "../data/models";
import BuyButton from "./BuyButton.astro";

interface Props {
  model: MowerModel;
  label?: string;
}
const { model, label } = Astro.props;
---

<div class="sticky-cta" id="sticky-cta" hidden>
  <div class="sc-text">
    {label && <span class="sc-label">{label}</span>}
    <strong>{model.shortName}</strong>
    <span class="sc-price">from {formatMoney(model.priceLow)}</span>
  </div>
  <BuyButton model={model} label="Check price" size="sm" />
  <button class="sc-close" type="button" aria-label="Dismiss">×</button>
</div>

<script>
  // Show after the reader scrolls past the intro; dismissible for the session.
  const bar = document.getElementById("sticky-cta");
  if (bar && !sessionStorage.getItem("cta-dismissed")) {
    const onScroll = () => {
      bar.hidden = window.scrollY < 900;
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    bar.querySelector(".sc-close")?.addEventListener("click", () => {
      sessionStorage.setItem("cta-dismissed", "1");
      window.removeEventListener("scroll", onScroll);
      bar.hidden = true;
    });
  }
</script>
