---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE_NAME, SITE_URL } from "../../lib/site";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const url = `${SITE_URL}/posts/${post.id}/`;

const jsonLd: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.pubDate.toISOString(),
    dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
    author: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
    publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
    mainEntityOfPage: url,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: SITE_URL },
      { "@type": "ListItem", position: 2, name: "Guides", item: SITE_URL },
      { "@type": "ListItem", position: 3, name: post.data.title, item: url },
    ],
  },
];

if (post.data.faq?.length) {
  jsonLd.push({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: post.data.faq.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  });
}
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  canonical={url}
  jsonLd={jsonLd}
  article={{
    pubDate: post.data.pubDate.toISOString(),
    updatedDate: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  }}
>
  <div class="wrap" style="padding-top:2.5rem;">
    <article class="prose" id="article">
      <h1>{post.data.title}</h1>
      <p class="byline">
        Published{" "}
        {post.data.pubDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
        {post.data.updatedDate && (
          <>
            {" "}· Updated{" "}
            {post.data.updatedDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
          </>
        )}
      </p>
      <div class="affiliate-note">
        As an Amazon Associate {SITE_NAME} earns from qualifying purchases.
        Prices shown are approximate and change frequently — check the current price on Amazon.
      </div>
      <nav class="toc" id="toc" aria-label="Table of contents" hidden>
        <h2>On this page</h2>
        <ol id="toc-list"></ol>
      </nav>
      <Content />
      <aside class="related-tools" aria-label="Related tools">
        <h2>Don't guess — calculate</h2>
        <ul>
          <li><a href="/tools/size-matcher/">📐 Mower Size Matcher</a> — which models fit your lawn</li>
          <li><a href="/tools/cost-calculator/">💰 Robot vs. Lawn Service</a> — your payback period</li>
          <li><a href="/tools/slope-checker/">⛰️ Slope Checker</a> — can a mower climb your hill?</li>
        </ul>
      </aside>
      {post.data.faq?.length ? (
        <section class="faq" aria-label="Frequently asked questions">
          <h2>Frequently asked questions</h2>
          {post.data.faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <div>{f.a}</div>
            </details>
          ))}
        </section>
      ) : null}
    </article>
  </div>

  <script>
    // Build a table of contents from h2s and anchor them.
    const article = document.getElementById("article");
    const toc = document.getElementById("toc");
    const list = document.getElementById("toc-list");
    if (article && toc && list) {
      const heads = [...article.querySelectorAll("h2")].filter(
        (h) => !h.closest(".toc") && !h.closest(".related-tools") && !h.closest(".faq")
      );
      if (heads.length >= 3) {
        heads.forEach((h, i) => {
          const id = h.id || `section-${i}`;
          h.id = id;
          const li = document.createElement("li");
          const a = document.createElement("a");
          a.href = `#${id}`;
          a.textContent = h.textContent;
          li.appendChild(a);
          list.appendChild(li);
        });
        toc.hidden = false;
      }
    }
  </script>
</BaseLayout>
