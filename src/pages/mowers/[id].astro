---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import BuyButton from "../../components/BuyButton.astro";
import ProductImage from "../../components/ProductImage.astro";
import AccessoryList from "../../components/AccessoryList.astro";
import { AFFILIATE_REL, tagAmazonUrl } from "../../lib/amazon";
import ProductCard from "../../components/ProductCard.astro";
import PostCard from "../../components/PostCard.astro";
import StickyCta from "../../components/StickyCta.astro";
import { MODELS, acresOf, formatPrice, formatArea, formatMoney, gradeToDegrees, NAV_LABEL, type MowerModel } from "../../data/models";
import { SITE_NAME, SITE_URL } from "../../lib/site";
import { getPosts } from "../../lib/posts";
import { breadcrumbLd, faqLd, productLd, type Crumb } from "../../lib/schema";

export async function getStaticPaths() {
  const reviews = await getCollection("reviews");
  const posts = await getPosts();
  return MODELS.map((model) => ({
    params: { id: model.id },
    props: { model, review: reviews.find((r) => r.id === model.id), posts },
  }));
}

const { model: m, review, posts } = Astro.props as {
  model: MowerModel;
  review: Awaited<ReturnType<typeof getCollection<"reviews">>>[number] | undefined;
  posts: Awaited<ReturnType<typeof getPosts>>;
};
const Body = review ? (await render(review)).Content : null;
const url = `${SITE_URL}/mowers/${m.id}/`;
const ogImage = `${SITE_URL}/og/mowers/${m.id}.png`;
const updated = review?.data.updatedDate ?? new Date("2026-10-07");
const fmtDate = (x: Date) => x.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });

// Alternatives: closest in coverage among other models, preferring another brand.
const alternatives = MODELS.filter((x) => x.id !== m.id)
  .map((x) => ({
    x,
    d: Math.abs(Math.log(x.maxSqFt / m.maxSqFt)) + (x.brand === m.brand ? 0.6 : 0) + Math.abs(x.priceLow - m.priceLow) / 2000,
  }))
  .sort((a, b) => a.d - b.d)
  .slice(0, 3)
  .map((a) => a.x);

const mentionedIn = posts.filter((p) => p.data.picks?.some((pk) => pk.id === m.id)).slice(0, 4);

// SEO title and description sized for search results.
const titleName = m.shortName.toLowerCase().startsWith(m.brand.toLowerCase()) ? m.shortName : `${m.brand} ${m.shortName}`;
const longTitle = `${titleName} Review (2026): Pros, Cons & Price`;
const title = longTitle.length <= 58 ? longTitle : `${titleName} Review (2026)`;
const navShort = m.navTech.map((t) => NAV_LABEL[t]).join(" + ");
const description = `${titleName} review: up to ${acresOf(m.maxSqFt)} acres, ${m.maxSlopePct}% slopes, ${navShort}. Pros, cons, alternatives and our ${m.score}/10 verdict.`;

const crumbs: Crumb[] = [
  { name: "Home", href: "/" },
  { name: "Compare mowers", href: "/mowers/" },
  { name: m.name, href: `/mowers/${m.id}/` },
];
const jsonLd: Record<string, unknown>[] = [productLd(m, url, updated, ogImage), breadcrumbLd(crumbs)];
if (review?.data.faq?.length) jsonLd.push(faqLd(review.data.faq));

const specs: [string, string][] = [
  ["Brand", m.brand],
  ["Released", String(m.releaseYear)],
  ["Max lawn area", formatArea(m.maxSqFt)],
  ["Max slope", `${m.maxSlopePct}% (~${gradeToDegrees(m.maxSlopePct).toFixed(0)}°)`],
  ["Navigation", m.nav],
  ["RTK base station", m.needsRtkStation ? "Required" : "Not required"],
  ["Drive", m.drive === "AWD" ? "All-wheel drive" : m.drive === "Tracks" ? "Tank tracks" : "Two-wheel drive"],
  ["Cutting width", m.cutWidthIn ? `${m.cutWidthIn}"` : "Not published"],
  ["Cutting height", `${m.cutHeightIn[0]}"–${m.cutHeightIn[1]}"`],
  ...(m.noiseDb ? ([["Noise", `${m.noiseDb} dB(A)`]] as [string, string][]) : []),
  ...(m.ipRating ? ([["Weather rating", m.ipRating]] as [string, string][]) : []),
  ["Connectivity", m.connectivity],
  ["Anti-theft", m.antiTheft],
  ["Typical price", formatPrice(m)],
];
const bars: [string, number][] = [
  ["Navigation", m.scores.navigation],
  ["Terrain & slopes", m.scores.terrain],
  ["Coverage", m.scores.coverage],
  ["Value", m.scores.value],
];
---

<BaseLayout title={title} description={description} canonical={url} ogImage={ogImage} jsonLd={jsonLd}>
  <div class="wrap post-wrap">
    <Breadcrumbs crumbs={crumbs} />

    <div data-pagefind-body>
    <header class="review-hero">
      <div class="rh-art"><ProductImage model={m} size={200} eager /></div>
      <div class="rh-body">
        <span class="post-tag">{m.brand} · {m.tier === "budget" ? "Budget" : m.tier === "mid" ? "Mid-range" : "Premium"}</span>
        <h1>{m.name} Review</h1>
        <p class="rh-best">{m.bestFor}</p>
        <div class="rh-meta">
          <span class="score lg" title="Guide score out of 10">{m.score.toFixed(1)}<small>/10</small></span>
          <span class="rh-price">{formatPrice(m)}<small>typical price</small></span>
        </div>
        <BuyButton model={m} />
        <p class="byline">
          By <a href="/about/">{SITE_NAME} Editorial Team</a> ·
          <time datetime={updated.toISOString()}>Updated {fmtDate(updated)}</time> ·
          <a href="/how-we-research/">How we score</a>
        </p>
      </div>
    </header>

    <div class="affiliate-note">
      We may earn a commission when you buy through links on this page, at no extra cost to you.
      Our score comes from manufacturer specs, professional reviews, and owner reports. It is not
      a hands-on lab test.
    </div>

    <section class="review-grid">
      <div class="verdict-box">
        <h2>The verdict</h2>
        <p>{m.verdict}</p>
        <div class="pc-proscons big">
          <div>
            <h3>What we like</h3>
            <ul class="pros">{m.pros.map((p) => <li>{p}</li>)}</ul>
          </div>
          <div>
            <h3>Watch out for</h3>
            <ul class="cons">{m.cons.map((c) => <li>{c}</li>)}</ul>
          </div>
        </div>
      </div>
      <div class="score-box">
        <h2>Score breakdown</h2>
        {bars.map(([k, v]) => (
          <div class="bar">
            <span>{k}</span>
            <div class="bar-track"><div class="bar-fill" style={`width:${v * 10}%`}></div></div>
            <strong>{v}</strong>
          </div>
        ))}
        <p class="score-note">Navigation: {m.navTech.map((t) => NAV_LABEL[t]).join(" + ")}</p>
      </div>
    </section>

    <article class="prose">
      <h2 id="specs">{m.shortName} specs</h2>
      <table class="spec-table">
        <tbody>
          {specs.map(([k, v]) => <tr><th scope="row">{k}</th><td>{v}</td></tr>)}
        </tbody>
      </table>
      {m.specNotes?.length ? <ul class="spec-notes">{m.specNotes.map((n) => <li>{n}</li>)}</ul> : null}
      {m.tiers?.length ? (
        <>
          <h3 id="tiers">Which {m.shortName} size do you need?</h3>
          <table class="spec-table">
            <thead><tr><th>Version</th><th>Rated area</th><th>Typical price</th></tr></thead>
            <tbody>{m.tiers.map((t) => <tr><td>{t.name}</td><td>{formatArea(t.sqft)}</td><td>{formatMoney(t.price)}</td></tr>)}</tbody>
          </table>
        </>
      ) : null}
      <p class="fine">Specs are compiled from manufacturer listings and may change between production runs. Confirm on the retailer page before buying.</p>

      {Body && <Body />}

      <div class="inline-cta">
        <div>
          <strong>{m.name}</strong>
          <span>{formatPrice(m)} · up to {formatArea(m.maxSqFt)} · {m.maxSlopePct}% slopes</span>
        </div>
        <BuyButton model={m} />
      </div>

      <AccessoryList model={m} />

      {mentionedIn.length > 0 && (
        <>
          <h2 id="featured-in">Featured in our guides</h2>
          <ul>{mentionedIn.map((p) => <li><a href={`/posts/${p.id}/`}>{p.data.title}</a></li>)}</ul>
        </>
      )}

      {review?.data.faq?.length ? (
        <section class="faq" id="faq" aria-label="Frequently asked questions">
          <h2>{m.shortName} FAQ</h2>
          {review.data.faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <div>{f.a}</div>
            </details>
          ))}
        </section>
      ) : null}

      {m.sources.length > 0 && (
        <>
          <h2 id="sources">Sources</h2>
          <ul class="sources">
            {m.sources.map((s) => {
              const isAmazon = /^https?:\/\/(www\.)?amazon\.com\//.test(s);
              return <li><a href={isAmazon ? tagAmazonUrl(s) : s} rel={isAmazon ? AFFILIATE_REL : "noopener nofollow"} target="_blank">{new URL(s).hostname.replace(/^www\./, "")}</a></li>;
            })}
          </ul>
        </>
      )}
    </article>

    </div>
    <section aria-label="Alternatives">
      <h2 class="section-title" style="margin-top:3rem;">Alternatives to the {m.shortName}</h2>
      <div class="tp-grid alt-grid">
        {alternatives.map((a) => <ProductCard model={a} compact />)}
      </div>
      <p style="margin-top:1.25rem;"><a class="section-link" href="/mowers/">Compare all {MODELS.length} models →</a></p>
    </section>

    {posts.length > 0 && (
      <section class="related" aria-label="Buying guides">
        <h2 class="section-title">Helpful guides</h2>
        <div class="post-grid">{posts.filter((p) => p.data.category === "best").slice(0, 3).map((p) => <PostCard post={p} />)}</div>
      </section>
    )}
  </div>
  <StickyCta model={m} />
</BaseLayout>
