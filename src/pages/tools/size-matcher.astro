---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { MODELS } from "../../data/models";
import { amazonLink } from "../../lib/amazon";
import { SITE_NAME, SITE_URL } from "../../lib/site";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Visual from "../../components/Visual.astro";
import { breadcrumbLd } from "../../lib/schema";

const title = "Robot Mower Size Matcher — What Size Robot Lawn Mower Do I Need?";
const description =
  "Enter your lawn size, slope, and obstacles to find which wire-free robot lawn mowers actually fit your yard. Free sizing tool with model recommendations.";
const url = `${SITE_URL}/tools/size-matcher/`;

const crumbs = [
  { name: "Home", href: "/" },
  { name: "Tools", href: "/tools/" },
  { name: "Size matcher", href: "/tools/size-matcher/" },
];
const jsonLd = [
  breadcrumbLd(crumbs),
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "Robot Mower Size Matcher",
    applicationCategory: "UtilitiesApplication",
    operatingSystem: "Any",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    url,
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: "What size robot lawn mower do I need?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Choose a mower rated for at least 15-20% more area than your lawn, and check its maximum slope rating against your steepest hill. Use the size matcher — enter your square footage and slope to get matched models.",
        },
      },
      {
        "@type": "Question",
        name: "Can one robot mower handle a full acre?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Yes — models like the Segway Navimow X450 (1.5 acres), Navimow X390 (2.5 acres) and Husqvarna Automower 440 iQ (2 acres) are rated for an acre or more. Larger areas mean longer mowing schedules, so buy headroom above your actual lawn size.",
        },
      },
    ],
  },
];

const modelsJson = JSON.stringify(
  MODELS.map((m) => ({ id: m.id, name: m.name, maxSqFt: m.maxSqFt, maxSlopePct: m.maxSlopePct, nav: m.nav, navTech: m.navTech, drive: m.drive, priceLow: m.priceLow, priceHigh: m.priceHigh, bestFor: m.bestFor, score: m.score, tiers: (m.tiers ?? [{ name: m.name, sqft: m.maxSqFt, price: m.priceLow, asin: m.asin }]).map((t) => ({
    ...t,
    // Exact listing for this size when known, else a search for the tier name.
    link: t.asin ? amazonLink(m.query, t.asin) : m.tiers ? amazonLink(`${t.name} robot lawn mower`) : amazonLink(m.query, m.asin),
  })), link: amazonLink(m.query, m.asin) }))
);
---

<BaseLayout title={title} description={description} canonical={url} jsonLd={jsonLd}>
  <div class="wrap">
    <Breadcrumbs crumbs={crumbs} />
    <div class="calc-hero">
      <h1>What size robot lawn mower do I need?</h1>
      <p>
        Buying an undersized mower is the most common — and most expensive —
        mistake. Drag the sliders to describe your yard and we'll match you with
        wire-free models that actually fit.
      </p>
    </div>

    <div class="calc" id="size-calc">
      <div>
        <label for="area">Lawn area <output id="area-out">10,000 sq ft</output></label>
        <input id="area" type="range" min="1000" max="110000" step="500" value="10000" />
      </div>
      <div>
        <label for="slope">Steepest slope <output id="slope-out">15% grade</output></label>
        <input id="slope" type="range" min="0" max="100" step="5" value="15" />
      </div>
      <div class="row">
        <div>
          <label for="obstacles">Trees &amp; obstacles</label>
          <select id="obstacles">
            <option value="few">Few / open lawn</option>
            <option value="some">Some trees and beds</option>
            <option value="many">Many trees, narrow passages</option>
          </select>
        </div>
        <div>
          <label for="budget">Max budget <output id="budget-out">no limit</output></label>
          <input id="budget" type="range" min="600" max="5000" step="100" value="5000" />
        </div>
      </div>
      <p style="margin-top:1.5rem;"><button class="btn" id="match-btn" type="button">Find my mower 🌱</button></p>
      <div class="calc-result" id="size-result" aria-live="polite"></div>
    </div>

    <article class="prose" data-pagefind-body>
      <Visual name="diagram:lawn-sizes" />
      <h2>How the matching works</h2>
      <p>
        We filter for mowers rated at least 15% above your lawn size (headroom for
        charging time and narrow zones) and rated for your steepest slope. Yards
        with many obstacles get vision-guided models that handle complex layouts
        without a boundary wire.
      </p>
      <p>
        Still unsure about hills? Try the <a href="/tools/slope-checker/">slope compatibility checker</a>,
        or compare running costs with the <a href="/tools/cost-calculator/">robot vs. lawn service calculator</a>.
        For the full picture, read our <a href="/posts/best-robot-lawn-mowers-2026/">best robot mowers of 2026</a> guide.
      </p>
    </article>
  </div>

  <script define:vars={{ modelsJson, siteName: SITE_NAME }}>
    const MODELS = JSON.parse(modelsJson);
    const $ = (id) => document.getElementById(id);
    const area = $("area"), slope = $("slope"), budget = $("budget");

    function paint(el) {
      const pct = ((el.value - el.min) / (el.max - el.min)) * 100;
      el.style.setProperty("--fill", pct + "%");
    }
    function fmt(n) { return Math.round(n).toLocaleString("en-US"); }

    function sync() {
      [area, slope, budget].forEach(paint);
      $("area-out").textContent = fmt(area.value) + " sq ft";
      $("slope-out").textContent = slope.value + "% grade";
      $("budget-out").textContent = +budget.value >= 5000 ? "no limit" : "$" + fmt(budget.value);
    }
    [area, slope, budget].forEach((el) => el.addEventListener("input", sync));
    sync();

    $("match-btn").addEventListener("click", () => {
      const need = parseFloat(area.value) * 1.15;
      const hill = parseFloat(slope.value);
      const obstacles = $("obstacles").value;
      const maxBudget = +budget.value >= 5000 ? Infinity : parseFloat(budget.value);

      // For each model, the cheapest version (tier) that covers the lawn with headroom.
      let picks = MODELS.map((m) => {
        const tier = m.tiers.filter((t) => t.sqft >= need).sort((a, b) => a.price - b.price)[0];
        return tier ? { ...m, tier } : null;
      }).filter((m) => m && m.maxSlopePct >= hill && m.tier.price <= maxBudget);
      if (obstacles === "many") {
        const lidar = picks.filter((m) => m.navTech.includes("lidar"));
        if (lidar.length) picks = lidar;
      } else if (obstacles === "some") {
        picks.forEach((m) => { if (m.navTech.includes("lidar")) m.score += 0.3; });
      }
      // Rank by score, nudged toward cheaper options that do the job.
      picks.sort((a, b) => (b.score - b.tier.price / 2500) - (a.score - a.tier.price / 2500));
      const result = $("size-result");

      if (!picks.length) {
        result.innerHTML = "<h3>No match found</h3><p>No wire-free mower in our database covers that combination. Try raising your budget — very large or steep lawns may need a dealer-installed model.</p>";
      } else {
        const cards = picks.slice(0, 3).map((m, i) => `
          <div class="model-pick">
            <h4>${i === 0 ? "⭐ Best match: " : ""}<a href="/mowers/${m.id}/">${m.name}</a></h4>
            <p class="specs">Get the <strong>${m.tier.name}</strong> (${(m.tier.sqft / 43560).toFixed(2)} ac) · ~$${fmt(m.tier.price)} · climbs ${m.maxSlopePct}% grade · ${m.drive} · ${m.nav}</p>
            <p>${m.bestFor}</p>
            <div class="pc-actions"><a class="btn buy btn-sm" href="${m.tier.link}" rel="sponsored nofollow noopener" target="_blank">Check ${m.tier.name} price</a><a class="pc-review" href="/mowers/${m.id}/">Full review</a></div>
          </div>`).join("");
        result.innerHTML = `<h3>Top ${Math.min(3, picks.length)} matches for your lawn</h3>${cards}
          <p class="disclosure">As an Amazon Associate ${siteName} earns from qualifying purchases. Prices change — verify on Amazon.</p>`;
      }
      result.classList.add("show");
      result.scrollIntoView({ behavior: "smooth", block: "nearest" });
    });
  </script>
</BaseLayout>
